# A caching mirror of haxelib's release files, for play.html's libraries: haxelib's file
# server doesn't let web pages read its zips, so the page asks its own site instead, and
# this fetches each release from haxelib-files.haxe.org once and keeps it. A release never
# changes, so a kept one is served for as long as it's kept (ten years unused, at most
# 20 GB). Only release files (/files/3.0/<name>-<1,2,3>.zip): it isn't a general proxy.
#
# For the wg-nginx container (~/services/nginx/templates/): it listens on this machine
# only, behind Apache, which passes the page's site's haxelib/ path to it (see
# apache-haxelib.conf), so the page reads it as its own site and other sites' pages can't.
# The cache wants a volume of its own (see README.md).

proxy_cache_path /var/cache/nginx/haxelib levels=1:2 keys_zone=haxelib:10m max_size=20g inactive=3650d use_temp_path=off;
# per visitor (the address Apache passes on), so one can't run the mirror's traffic up
limit_req_zone $binary_remote_addr zone=haxelib_requests:10m rate=5r/s;

server {
    listen 127.0.0.1:10080;
    server_name localhost;
    server_tokens off;

    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;

    location ~ ^/files/3\.0/[A-Za-z0-9_.+-]+-[0-9A-Za-z,+-]+\.zip$ {
        limit_req zone=haxelib_requests burst=20 nodelay;

        # looked up as requests come, not when nginx starts: a failed lookup at start would
        # stop nginx starting at all, and every site it serves with it
        resolver 127.0.0.53 1.1.1.1 valid=300s ipv6=off;
        set $haxelib_files https://haxelib-files.haxe.org;
        proxy_pass $haxelib_files;
        proxy_set_header Host haxelib-files.haxe.org;
        proxy_ssl_server_name on;
        proxy_ssl_name haxelib-files.haxe.org;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

        proxy_cache haxelib;
        proxy_cache_valid 200 3650d;
        proxy_cache_valid 404 10m;       # a release that isn't there (yet): asked again later
        proxy_cache_lock on;             # one fetch for many asking at once
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        proxy_hide_header Set-Cookie;

        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    location / {
        return 404;
    }
}
