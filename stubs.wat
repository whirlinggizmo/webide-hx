   (func (export "luv_stub_71_luv_get_write_trampoline") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
   (func (export "luv_stub_72_luv_get_connection_trampoline") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
   (func (export "luv_stub_73_luv_get_read_trampoline") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
   (func (export "luv_stub_blocking_4_luv_get_fs_trampoline") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
   (func (export "luv_stub_blocking_5_luv_null_fs_callback_pointer") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
