;; The C libraries Haxe links, for the wasm build (web/haxe-wasm.js, by wasm_of_ocaml): what
;; stubs.js is for the JS build. A primitive here is a Wasm function taking and returning
;; OCaml values; JavaScript does what Wasm can't (regular expressions, paths, the clock),
;; through stubs-wasm.js. Only what a build reaches is here: wasm_of_ocaml gives every other
;; C primitive a dummy that throws when it's called, which names it.
;; Files need nothing here: the runtime does them through node's fs, which the worker gives
;; it (web/hxfs.js, in memory).
(module
   (type $block (array (mut (ref eq))))
   (type $bytes (array (mut i8)))
   (type $float (struct (field f64)))
   (type $js (struct (field anyref)))

   (import "env" "caml_jsstring_of_string" (func $jsstring (param (ref eq)) (result (ref eq))))
   (import "env" "caml_string_of_jsstring" (func $of_jsstring (param (ref eq)) (result (ref eq))))
   (import "env" "caml_jsbytes_of_string" (func $jsbytes (param (ref eq)) (result (ref eq))))
   (import "env" "caml_string_of_jsbytes" (func $of_jsbytes (param (ref eq)) (result (ref eq))))
   (import "env" "Int64_val" (func $int64_val (param (ref eq)) (result i64)))
   (import "env" "caml_copy_nativeint" (func $caml_copy_nativeint (param i32) (result (ref eq))))
   (import "env" "caml_failwith" (func $failwith (param (ref eq))))
   (import "env" "caml_raise_not_found" (func $raise_not_found))
   (import "env" "caml_named_value" (func $named_value (param (ref eq)) (result (ref null eq))))
   (import "env" "caml_callback_1" (func $callback_1 (param (ref eq)) (param (ref eq)) (result (ref eq))))

   (import "js" "hx_w_expose" (func $js_expose (param funcref)))
   (import "js" "hx_w_now" (func $js_now (result f64)))
   (import "js" "hx_w_filetime" (func $js_filetime (param anyref) (result f64)))
   (import "js" "hx_w_full_path" (func $js_full_path (param anyref) (result anyref)))
   (import "js" "hx_w_sha1_init" (func $js_sha1_init (result anyref)))
   (import "js" "hx_w_sha1_update" (func $js_sha1_update (param anyref) (param anyref)))
   (import "js" "hx_w_sha1_final" (func $js_sha1_final (param anyref) (result anyref)))
   (import "js" "hx_w_hex" (func $js_hex (param anyref) (result anyref)))
   (import "js" "hx_w_regexp" (func $js_regexp (param anyref) (param i32) (result anyref)))
   (import "js" "hx_w_regexp_error" (func $js_regexp_error (param anyref) (result anyref)))
   (import "js" "hx_w_regexp_groups" (func $js_regexp_groups (param anyref) (result i32)))
   (import "js" "hx_w_regexp_exec" (func $js_regexp_exec (param anyref) (param anyref) (param i32) (result anyref)))
   (import "js" "hx_w_index" (func $js_index (param anyref) (param i32) (result i32)))

   ;; between OCaml's values and JavaScript's: a string as a JS string of its bytes (latin1),
   ;; or of its text (UTF-8, for paths); an int; a JS value an OCaml value holds
   (func $to_js_bytes (param $s (ref eq)) (result anyref)
      (struct.get $js 0 (ref.cast (ref $js) (call $jsbytes (local.get $s)))))
   (func $of_js_bytes (param $s anyref) (result (ref eq))
      (call $of_jsbytes (struct.new $js (local.get $s))))
   (func $to_js_text (param $s (ref eq)) (result anyref)
      (struct.get $js 0 (ref.cast (ref $js) (call $jsstring (local.get $s)))))
   (func $of_js_text (param $s anyref) (result (ref eq))
      (call $of_jsstring (struct.new $js (local.get $s))))
   (func $int (param $v (ref eq)) (result i32)
      (i31.get_s (ref.cast (ref i31) (local.get $v))))
   (func $held (param $v (ref eq)) (result anyref)
      (struct.get $js 0 (ref.cast (ref $js) (local.get $v))))

   ;; the resident compiler (--wait stdio, HAXE_RESIDENT=1) registers its request handler
   ;; as "haxe_resident_request"; JavaScript gets a function that calls it (hx_request: the
   ;; hxml in, what a connection would be sent back out, both latin1), handed over the
   ;; first time the compiler asks the time, which it does as it starts
   (@string $request_name "haxe_resident_request")
   (elem declare func $request)
   (func $request (param $hxml anyref) (result anyref)
      (local $f (ref null eq))
      (local.set $f (call $named_value (global.get $request_name)))
      (if (ref.is_null (local.get $f)) (then (return (ref.null any))))
      (call $to_js_bytes
         (call $callback_1 (ref.as_non_null (local.get $f)) (call $of_js_bytes (local.get $hxml)))))
   (global $exposed (mut i32) (i32.const 0))
   (func $expose
      (if (i32.eqz (global.get $exposed))
         (then
            (global.set $exposed (i32.const 1))
            (call $js_expose (ref.func $request)))))

   ;; extc: paths and time
   (func (export "sys_time") (param (ref eq)) (result (ref eq))
      (call $expose)
      (struct.new $float (call $js_now)))
   (func (export "sys_filetime") (param $p (ref eq)) (result (ref eq))
      (struct.new $float (call $js_filetime (call $to_js_text (local.get $p)))))
   (func (export "get_full_path") (param $p (ref eq)) (result (ref eq))
      (call $expose)
      (call $of_js_text (call $js_full_path (call $to_js_text (local.get $p)))))
   (func (export "get_real_path") (param $p (ref eq)) (result (ref eq))
      (call $of_js_text (call $js_full_path (call $to_js_text (local.get $p)))))
   (@string $executable "/haxe/haxe")
   (func (export "executable_path") (param (ref eq)) (result (ref eq))
      (call $expose)
      (global.get $executable))

   ;; sha1 (the `sha` library): the digest in JavaScript, a context there too
   (func (export "stub_sha1_init") (param (ref eq)) (result (ref eq))
      (struct.new $js (call $js_sha1_init)))
   (func (export "stub_sha1_update") (param $ctx (ref eq)) (param $s (ref eq)) (param $pos (ref eq)) (param $len (ref eq)) (result (ref eq))
      (local $part (ref $bytes))
      (local.set $part (array.new $bytes (i32.const 0) (call $int (local.get $len))))
      (array.copy $bytes $bytes (local.get $part) (i32.const 0)
         (ref.cast (ref $bytes) (local.get $s)) (call $int (local.get $pos)) (call $int (local.get $len)))
      (call $js_sha1_update (call $held (local.get $ctx)) (call $to_js_bytes (local.get $part)))
      (ref.i31 (i32.const 0)))
   (func (export "stub_sha1_finalize") (param $ctx (ref eq)) (result (ref eq))
      (call $of_js_bytes (call $js_sha1_final (call $held (local.get $ctx)))))
   (func (export "stub_sha1_to_bin") (param $d (ref eq)) (result (ref eq))
      (local.get $d))
   (func (export "stub_sha1_to_hex") (param $d (ref eq)) (result (ref eq))
      (call $of_js_bytes (call $js_hex (call $to_js_bytes (local.get $d)))))

   ;; pcre2 on JS RegExp, as in stubs.js: byte strings (latin1), so offsets are byte
   ;; offsets as PCRE2 gives them; no named groups, callouts or DFA matcher
   (@string $pcre2_version "10.42 (js)")
   (func (export "pcre2_version_stub") (param (ref eq)) (result (ref eq))
      (global.get $pcre2_version))
   (func (export "pcre2_compile_stub_bc") (param $flags (ref eq)) (param $tables (ref eq)) (param $pattern (ref eq)) (result (ref eq))
      (local $re anyref) (local $error anyref)
      (local.set $re (call $js_regexp (call $to_js_bytes (local.get $pattern)) (i32.wrap_i64 (call $int64_val (local.get $flags)))))
      (local.set $error (call $js_regexp_error (local.get $re)))
      (if (i32.eqz (ref.is_null (local.get $error)))
         (then (call $failwith (call $of_js_bytes (local.get $error))) (unreachable)))
      (struct.new $js (local.get $re)))
   (func (export "pcre2_capturecount_stub_bc") (param $re (ref eq)) (result (ref eq))
      (ref.i31 (call $js_regexp_groups (call $held (local.get $re)))))
   (func (export "pcre2_match_stub_bc")
      (param $flags (ref eq)) (param $re (ref eq)) (param $pos (ref eq)) (param $start (ref eq))
      (param $subject (ref eq)) (param $ovector (ref eq)) (param $callout (ref eq)) (result (ref eq))
      (local $m anyref) (local $n i32) (local $i i32) (local $ov (ref $block))
      (local.set $m (call $js_regexp_exec (call $held (local.get $re)) (call $to_js_bytes (local.get $subject)) (call $int (local.get $pos))))
      (if (ref.is_null (local.get $m)) (then (call $raise_not_found) (unreachable)))
      ;; each group's start and end, -1 for one that didn't take part
      (local.set $n (i32.shl (i32.add (call $js_regexp_groups (call $held (local.get $re))) (i32.const 1)) (i32.const 1)))
      (local.set $ov (ref.cast (ref $block) (local.get $ovector)))
      (loop $fill
         (if (i32.lt_u (local.get $i) (local.get $n))
            (then
               (array.set $block (local.get $ov) (i32.add (local.get $i) (i32.const 1))
                  (ref.i31 (call $js_index (local.get $m) (local.get $i))))
               (local.set $i (i32.add (local.get $i) (i32.const 1)))
               (br $fill))))
      (ref.i31 (i32.const 0)))

   ;; mbedtls' flag tables, read at startup (eval's sys.ssl): empty
   (func (export "hx_get_ssl_authmode_flags") (param (ref eq)) (result (ref eq)) (array.new_fixed $block 1 (ref.i31 (i32.const 0))))
   (func (export "hx_get_ssl_endpoint_flags") (param (ref eq)) (result (ref eq)) (array.new_fixed $block 1 (ref.i31 (i32.const 0))))
   (func (export "hx_get_ssl_preset_flags") (param (ref eq)) (result (ref eq)) (array.new_fixed $block 1 (ref.i31 (i32.const 0))))
   (func (export "hx_get_ssl_transport_flags") (param (ref eq)) (result (ref eq)) (array.new_fixed $block 1 (ref.i31 (i32.const 0))))

   ;; ctypes: a C string read at startup (luv's version suffix), and a buffer's address
   (func (export "ctypes_string_of_cstring") (param (ref eq)) (result (ref eq)) (array.new_fixed $bytes 0))
   (func (export "ctypes_block_address") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))

   ;; threads and mutexes: no-ops, as in stubs.js (the compiler is single-threaded here)
   (func (export "caml_thread_initialize") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "caml_thread_self") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "caml_thread_id") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "caml_thread_yield") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "caml_thread_join") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "caml_thread_exit") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "caml_thread_uncaught_exception") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "caml_mutex_new") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "caml_mutex_lock") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "caml_mutex_try_lock") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 1)))
   (func (export "caml_mutex_unlock") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "caml_condition_new") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "caml_condition_wait") (param (ref eq)) (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "caml_condition_signal") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))

   ;; pcre2's configuration
   (func (export "pcre2_ocaml_init") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "pcre2_config_unicode_stub") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 1)))
   (func (export "pcre2_config_newline_stub") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 10)))
   (func (export "pcre2_config_link_size_stub_bc") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 2)))
   (func (export "pcre2_config_match_limit_stub_bc") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 10000000)))
   (func (export "pcre2_config_depth_limit_stub_bc") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 10000000)))
   (func (export "pcre2_config_stackrecurse_stub") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))

   ;; constants read when their modules load (ctypes, integers), and the compiler's own
   (func (export "integers_unsigned_init") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "integers_ushort_size") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 2)))
   (func (export "integers_uint_size") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 4)))
   (func (export "integers_ulong_size") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 8)))
   (func (export "integers_ulonglong_size") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 8)))
   (func (export "integers_size_t_size") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 8)))
   (func (export "integers_intptr_t_size") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 8)))
   (func (export "integers_uintptr_t_size") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 8)))
   (func (export "integers_ptrdiff_t_size") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 8)))
   (func (export "ctypes_typeof_clock_t") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 3)))
   (func (export "ctypes_typeof_dev_t") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 7)))
   (func (export "ctypes_typeof_ino_t") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 7)))
   (func (export "ctypes_typeof_mode_t") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 6)))
   (func (export "ctypes_typeof_nlink_t") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 7)))
   (func (export "ctypes_typeof_off_t") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 3)))
   (func (export "ctypes_typeof_pid_t") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 2)))
   (func (export "ctypes_typeof_ssize_t") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 3)))
   (func (export "ctypes_typeof_time_t") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 3)))
   (func (export "ctypes_typeof_useconds_t") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 6)))
   (func (export "ctypes_alignmentof_sigset_t") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 8)))
   (func (export "ctypes_sizeof_sigset_t") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 128)))
   (func (export "ctypes_write") (param (ref eq)) (param (ref eq)) (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "luv_set_once_callback") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "sys_getch") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "ml_objsize") (param (ref eq)) (param (ref eq)) (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))

   ;; integers' unsigned values and ctypes' buffers: made as their modules load, never used by
   ;; the compiler; a placeholder each
   (func (export "integers_uint32_of_string") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "integers_uint32_of_int") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "integers_uint64_of_int") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "integers_uint32_of_int32") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "integers_uint64_of_string") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "integers_uint64_of_int64") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "integers_uint32_max") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "integers_uint64_max") (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))
   (func (export "ctypes_allocate") (param (ref eq)) (param (ref eq)) (result (ref eq)) (ref.i31 (i32.const 0)))

   ;; pointers, as ctypes has them: raw addresses (nativeint); luv's callbacks are never called
   (func (export "luv_stub_129_luv_get_send_trampoline") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
   (func (export "luv_stub_132_luv_get_recv_trampoline") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
   (func (export "luv_stub_138_luv_get_exit_trampoline") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
   (func (export "luv_stub_139_luv_null_exit_trampoline") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
   (func (export "luv_stub_145_luv_get_fs_event_trampoline") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
   (func (export "luv_stub_149_luv_get_fs_poll_trampoline") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
   (func (export "luv_stub_153_luv_get_getaddrinfo_trampoline") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
   (func (export "luv_stub_156_luv_get_getnameinfo_trampoline") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
   (func (export "luv_stub_168_luv_get_work_trampoline") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
   (func (export "luv_stub_169_luv_get_after_work_trampoline") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
   (func (export "luv_stub_170_luv_get_c_work_trampoline") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
   (func (export "luv_stub_171_luv_get_after_c_work_trampoline") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
   (func (export "luv_stub_174_luv_get_thread_trampoline") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
