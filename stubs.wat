   (func (export "luv_stub_36_luv_get_timer_trampoline") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
   (func (export "luv_stub_44_luv_get_prepare_trampoline") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
   (func (export "luv_stub_48_luv_get_check_trampoline") (param (ref eq)) (result (ref eq)) (call $caml_copy_nativeint (i32.const 0)))
